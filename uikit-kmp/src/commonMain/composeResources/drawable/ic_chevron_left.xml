        android:pathData="M660,00 L260,480 L660,990"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="50"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"/>
