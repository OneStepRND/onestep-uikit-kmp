<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">

    <!--
      A right‐pointing chevron, drawn as a single stroked path.
      Stroke is thick, with round caps and joins, so the ends
      and the corner are perfectly rounded.
    -->
    <path
        android:pathData="M300,00 L700,480 L300,990"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="50"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"/>
</vector>