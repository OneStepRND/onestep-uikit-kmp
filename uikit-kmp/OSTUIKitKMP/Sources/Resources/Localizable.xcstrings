    "Great job for measuring! Make sure to follow the measurement instructions to get an analysis." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הכבוד על המדידה! כדי לקבל תוצאות מדויקות, חשוב לפעול לפי ההוראות."
          }
