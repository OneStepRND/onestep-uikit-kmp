    "If your path is short, walk as far as you can, then turn around and repeat until time is up." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם אין מספיק מקום, הסתובבו והמשיכו ללכת הלוך ושוב עד לסיום הזמן."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если путь короткий, пройдите столько, сколько сможете, затем повернитесь и повторяйте, пока не закончится время."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если путь короткий, пройдите столько, сколько сможете, затем повернитесь и повторяйте, пока не закончится время."
          }
        },
        "uk" : {
          "stringUnit" : {
