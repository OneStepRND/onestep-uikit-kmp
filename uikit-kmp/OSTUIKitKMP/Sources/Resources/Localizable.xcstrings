    "For a successful analysis you need to stand up and sit back down as many times as you can until the time counter stops." : {
      "extractionState" : "manual",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להשלים את הבדיקה, קומו והתיישבו שוב כמה שיותר פעמים עד שהזמן מסתיים."
          }
