        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для успешного анализа вам нужно вставать и садиться как можно больше раз, пока не остановится счетчик времени."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для успешного анализа вам нужно вставать и садиться как можно больше раз, пока не остановится счетчик времени."
          }
        },
