    "getReadyTextDaulTaskSubtract" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This activity is 60 seconds long. You will walk at your normal, comfortable pace. At the same time, start counting out loud and clear by subtracting 3 from 111. Keep subtracting 3 from your answer until you're told to stop. Please begin walking and counting when you are ready."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעילות הזו אורכת 60 שניות. תלכו בקצב הרגיל והנוח לכם. באותו זמן, התחילו לספור בקול רם וברור על ידי חיסור 3 מ-111. המשיכו לחסר 3 מהתשובה שלכם עד שיאמרו לכם להפסיק. אנא התחילו ללכת ולספור כשאתם מוכנים."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это упражнение длится 60 секунд. Идите в обычном, комфортном для вас темпе. Одновременно считайте вслух и чётко, начиная с 111 и вычитая по 3. Продолжайте вычитать 3 из полученного результата, пока вам не скажут остановиться. Когда будете готовы, начните идти и считать."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это упражнение длится 60 секунд. Идите в обычном, комфортном для вас темпе. Одновременно считайте вслух и чётко, начиная с 111 и вычитая по 3. Продолжайте вычитать 3 из полученного результата, пока вам не скажут остановиться. Когда будете готовы, начните идти и считать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это упражнение длится 60 секунд. Идите в обычном, комфортном для вас темпе. Одновременно считайте вслух и чётко, начиная с 111 и вычитая по 3. Продолжайте вычитать 3 из полученного результата, пока вам не скажут остановиться. Когда будете готовы, начните идти и считать."
          }
        }
      }
    },
